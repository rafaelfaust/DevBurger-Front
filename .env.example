NEXT_PUBLIC_THEME_LINE=#ddd5c8
NEXT_PUBLIC_THEME_SUCCESS=#1c7a45

# Domínio da plataforma: pizzaria.SEU_DOMINIO abre a loja "pizzaria".
PLATFORM_DOMAIN=

# Segmento da loja padrão no db:seed: hamburgueria, pizzaria, acai, japonesa,
# marmitaria, lanchonete, doceria ou outro. Lojas do APP_TENANT_CONFIG usam o campo "segment".
APP_DEFAULT_SEGMENT=hamburgueria

# As variáveis de marca acima e o JSON abaixo só servem de semente para `npm run db:seed`.
# Depois disso cada loja edita a própria marca em Admin → Aparência.
# Exemplo em linha única:
# APP_TENANT_CONFIG='[{"key":"acai-prime","segment":"acai","hosts":["acai.localhost","acai.exemplo.com","*.acai.exemplo.com"],"branding":{"brandName":"Acai Prime","brandWordmarkLead":"ACAI","brandWordmarkTrail":"PRIME","namespace":"acai-prime","homeTitleHighlight":"entregar","assets":{"logoPath":"/tenants/acai-prime/logo.svg","faviconPath":"/tenants/acai-prime/favicon.svg","homeHeroPath":"/tenants/acai-prime/home-hero.svg","catalogHeroPath":"/tenants/acai-prime/catalog-hero.svg","loginImagePath":"/tenants/acai-prime/login-hero.svg","registerImagePath":"/tenants/acai-prime/register-hero.svg"},"theme":{"primary":"#6d28d9","accent":"#1d4ed8"}}}]'

# Postgres (Neon, Supabase...). Vazio em dev = PGlite embutido em .data/pglite.
DATABASE_URL=

# Checkout falso para testes locais. Ignorado em produção.
ALLOW_DEMO_CHECKOUT=true

# Credenciais privadas: nunca use NEXT_PUBLIC_ nestas variáveis.
MERCADO_PAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADO_PAGO_WEBHOOK_SECRET=

# Cloudflare R2 para imagens (produtos e marca). Sem isso, em dev as imagens vão para public/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=devburger-imagens
# Endereço público do bucket (r2.dev para teste; domínio próprio em produção).
R2_PUBLIC_URL=
