# JSON opcional para resolver branding por domínio/subdomínio.
# Exemplo em linha única:
# APP_TENANT_CONFIG='[{"key":"acai-prime","hosts":["acai.localhost","acai.exemplo.com","*.acai.exemplo.com"],"branding":{"brandName":"Acai Prime","brandWordmarkLead":"ACAI","brandWordmarkTrail":"PRIME","namespace":"acai-prime","homeTitleHighlight":"entregar","assets":{"logoPath":"/tenants/acai-prime/logo.svg","faviconPath":"/tenants/acai-prime/favicon.svg","homeHeroPath":"/tenants/acai-prime/home-hero.svg","catalogHeroPath":"/tenants/acai-prime/catalog-hero.svg","loginImagePath":"/tenants/acai-prime/login-hero.svg","registerImagePath":"/tenants/acai-prime/register-hero.svg"},"theme":{"primary":"#6d28d9","accent":"#1d4ed8"}}}]'

# Checkout local para testes sem Mercado Pago.
ALLOW_DEMO_CHECKOUT=true

# Compatibilidade legada. A storefront agora usa banco local por padrão.
APP_BACKEND_URL=
APP_SERVICE_TOKEN=

# Aliases legados ainda suportados.
DEV_BURGER_API_URL=http://localhost:3001

# Credenciais privadas: nunca use NEXT_PUBLIC_ nestas variáveis.
MERCADO_PAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADO_PAGO_WEBHOOK_SECRET=

# Token opcional para o webhook atualizar pedidos no backend.
DEV_BURGER_SERVICE_TOKEN=

