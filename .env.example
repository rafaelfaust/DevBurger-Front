NEXT_PUBLIC_THEME_INK=#171512
NEXT_PUBLIC_THEME_MUTED=#6f6a62
NEXT_PUBLIC_THEME_PAPER=#f7f3eb
NEXT_PUBLIC_THEME_CARD=#fffdf8
NEXT_PUBLIC_THEME_PRIMARY=#f5b82e
NEXT_PUBLIC_THEME_PRIMARY_DARK=#d89300
